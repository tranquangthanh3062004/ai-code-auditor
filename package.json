{
  "name": "ai-code-auditor",
  "version": "0.2.0",
  "description": "Autonomous Verification, Security & Acceptance Platform for Generative AI & Vibe Coding",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codetrust": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "web",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/audit.test.ts",
    "dev": "concurrently -n \"SERVER,VITE\" -c \"cyan,magenta\" \"tsx watch server/index.ts\" \"vite web --port 5173\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite web --port 5173",
    "server": "tsx server/index.ts",
    "ui": "tsx server/index.ts",
    "audit": "tsx src/cli/bin.ts",
    "mcp": "tsx src/mcp/bin.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ai",
    "code-audit",
    "vibe-coding",
    "multi-agent",
    "mcp",
    "model-context-protocol",
    "security-scanner",
    "deepseek",
    "zero-hallucination",
    "agent-skills",
    "acceptance-testing",
    "code-quality",
    "developer-tools",
    "web-ui"
  ],
  "author": "Tran Quang Thanh <tranquangthanh3062004@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tranquangthanh3062004/ai-code-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/tranquangthanh3062004/ai-code-auditor/issues"
  },
  "homepage": "https://github.com/tranquangthanh3062004/ai-code-auditor#readme",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "open": "^10.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^8.2.2"
  }
}
